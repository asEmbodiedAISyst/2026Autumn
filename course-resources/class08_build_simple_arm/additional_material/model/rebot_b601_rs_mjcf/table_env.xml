<!--
  Tabletop environment shared by all scenes (no robot, no task objects).

  Frame convention: the world origin is the center of the robot base, on the table top surface (z = 0).
  +x points straight ahead of the arm (towards the middle of the table), +z points up. The floor is at z = -0.75.
  Scene files combine: an end effector (robot with gripper / robot with pusher tool / handheld tool)
  + this environment + task objects (objects_*.xml).
-->
<mujoco model="table_env">

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <statistic center="0.25 0 0.1" extent="0.7"/>

  <visual>
    <headlight diffuse="0.35 0.35 0.35" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.5 0.65" rgb2="0.05 0.07 0.09" width="512" height="3072"/>
    <texture type="2d" name="floor_tex" builtin="checker" mark="edge" rgb1="0.22 0.26 0.28" rgb2="0.15 0.18 0.2"
             markrgb="0.5 0.5 0.5" width="300" height="300"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <texture type="2d" name="table_tex" builtin="flat" rgb1="0.78 0.72 0.62" rgb2="0.7 0.64 0.55" mark="random"
             random="0.05" markrgb="0.72 0.66 0.56" width="512" height="512"/>
    <material name="table_top_mat" texture="table_tex" texrepeat="2 2" rgba="1 1 1 1" specular="0.1" shininess="0.2"/>
    <material name="table_leg_mat" rgba="0.25 0.25 0.27 1" specular="0.4"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.3 -0.4 1.4" dir="0 0.25 -1" directional="false" castshadow="true"
           diffuse="0.45 0.45 0.45" attenuation="1 0 0" cutoff="70"/>
    <light name="fill" pos="-0.6 0.6 1.2" dir="0.4 -0.4 -1" directional="true" castshadow="false" diffuse="0.25 0.25 0.25"/>

    <geom name="floor" type="plane" pos="0 0 -0.75" size="3 3 0.05" material="floor_mat"/>

    <!-- Table: 1.2 m x 0.8 m, top surface at z=0, robot base near the back edge -->
    <body name="table" pos="0.35 0 0">
      <geom name="table_top" type="box" pos="0 0 -0.015" size="0.6 0.4 0.015" material="table_top_mat"
            friction="0.4 0.005 0.0001"/>
      <geom type="box" pos="0.55 0.35 -0.39" size="0.025 0.025 0.36" material="table_leg_mat" contype="0" conaffinity="0"/>
      <geom type="box" pos="0.55 -0.35 -0.39" size="0.025 0.025 0.36" material="table_leg_mat" contype="0" conaffinity="0"/>
      <geom type="box" pos="-0.55 0.35 -0.39" size="0.025 0.025 0.36" material="table_leg_mat" contype="0" conaffinity="0"/>
      <geom type="box" pos="-0.55 -0.35 -0.39" size="0.025 0.025 0.36" material="table_leg_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Fixed cameras: front / side match the camera keys of the Seeed LeRobot tutorial; top is an elevated overview camera -->
    <camera name="front" pos="0.64 0 0.46" xyaxes="0.000 1.000 0.000 -0.779 0.000 0.627" fovy="55"/>
    <camera name="side" pos="0.27 -0.52 0.36" xyaxes="1 0 0 0 0.569 0.822" fovy="60"/>
    <camera name="top" pos="0.62 0 0.80" xyaxes="0.000 1.000 0.000 -0.916 0.000 0.401" fovy="45"/>

  </worldbody>
</mujoco>
